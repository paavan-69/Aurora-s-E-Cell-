# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Primary administrator email address for Aurora E-Cell.
ADMIN_EMAIL="adminecell@gmail.com"

# ADMIN_INITIAL_PASSWORD: Optional protected initial password used only by the backend setup route
# to initialize the adminecell@gmail.com Firebase Auth account during deployment. Never exposed to client.
ADMIN_INITIAL_PASSWORD=""
