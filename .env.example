# ==============================================================================
# AURORA E-CELL — ENVIRONMENT CONFIGURATION (.env.example)
# Configure these variables in Vercel -> Project Settings -> Environment Variables
# ==============================================================================

# 1. FIREBASE CONFIGURATION (Optional overrides if not using firebase-applet-config.json)
# Used by the Express serverless API (/api/index.ts) to verify Firebase ID tokens
FIREBASE_API_KEY=""

# Optional Vite client-side Firebase overrides (defaults to firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID=""
VITE_GOOGLE_OAUTH_CLIENT_ID=""

# 2. ADMINISTRATOR AUTHORIZATION (Server-Side)
# Primary administrator email address checked on the backend (/api/auth/verify-role & /api/sheets/sync)
ADMIN_EMAIL="adminecell@gmail.com"

# 3. PROTECTED ADMIN BOOTSTRAP (Optional — used only by POST /api/auth/bootstrap-admin)
# Secret token (minimum 16 characters) required in the x-admin-setup-secret request header
ADMIN_BOOTSTRAP_SECRET=""
# Initial password (minimum 6 characters) for provisioning the admin account via backend bootstrap
ADMIN_INITIAL_PASSWORD=""

# 4. RUNTIME & AI STUDIO ENVIRONMENT
GEMINI_API_KEY=""
APP_URL=""
